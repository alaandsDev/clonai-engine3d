{
  "name": "clonai-engine3d",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "check:engine3d": "tsx --test tests/*.test.ts",
    "engine3d:catalog": "tsx cli/main.ts catalog",
    "engine3d:search": "tsx cli/main.ts search",
    "engine3d:studio": "remotion studio src/index.tsx",
    "engine3d:resolve-shot": "tsx cli/main.ts resolve-shot",
    "engine3d:director": "tsx cli/main.ts director",
    "engine3d:render-director": "tsx cli/main.ts render-director",
    "engine3d:previews": "tsx cli/main.ts previews",
    "check:engine3d:render": "tsx --test --test-concurrency=1 tests/integration/*.test.ts",
    "check:editorial": "tsx --test tests/editorial.test.ts",
    "check:editorial:render": "tsx --test tests/integration/editorial-render.test.ts",
    "engine3d:editorial": "tsx cli/editorial-pilot.ts",
    "engine3d:editorial:sfx": "tsx cli/editorial-sfx-check.ts",
    "sound:review": "tsx cli/sound-review.ts review",
    "sound:approve": "tsx cli/sound-review.ts approve",
    "sound:reject": "tsx cli/sound-review.ts reject",
    "check:sound": "tsx --test tests/sound.test.ts tests/sound-integration/*.test.ts",
    "check:sound:pack": "tsx cli/sound-review.ts pack",
    "check:sound:render": "tsx cli/sound-pilot.ts",
    "visual:inspect": "python cli/visual-inspect.py",
    "visual:approve": "tsx cli/visual-review.ts approve",
    "visual:reject": "tsx cli/visual-review.ts reject",
    "check:visual": "tsx --test tests/visual.test.ts tests/visual-integration/*.test.ts",
    "check:visual:pack": "tsx cli/visual-review.ts pack",
    "check:visual:render": "tsx cli/visual-pilot.ts",
    "check:motion": "tsx --test tests/directed.test.ts",
    "check:demonstration": "tsx --test tests/demonstration.test.ts",
    "autodirector:plan": "tsx cli/autodirector.ts plan",
    "autodirector:compile": "tsx cli/autodirector.ts compile",
    "check:autodirector": "tsx --test tests/autodirector.test.ts",
    "check:semantics": "tsx --test tests/semantics.test.ts",
    "semantics:analyze": "tsx cli/semantics.ts analyze",
    "semantics:plan": "tsx cli/semantics.ts plan",
    "check:narrative": "tsx --test tests/narrative.test.ts",
    "narrative:plan": "tsx cli/narrative.ts",
    "check:writer": "tsx --test tests/writer.test.ts",
    "writer:write": "tsx cli/writer.ts",
    "check:research": "tsx --test tests/research.test.ts",
    "research:plan": "tsx cli/research.ts plan",
    "research:build-pack": "tsx cli/research.ts build-pack",
    "research:inspect": "tsx cli/research.ts inspect",
    "research:ground-script": "tsx cli/research.ts ground-script",
    "research:web": "tsx cli/web-research.ts live",
    "research:web:replay": "tsx cli/web-research.ts replay",
    "research:web:inspect": "tsx cli/web-research.ts inspect",
    "check:web-research": "tsx --test tests/web-research.test.ts"
  },
  "dependencies": {
    "@react-three/fiber": "8.18.0",
    "@remotion/bundler": "4.0.539",
    "@remotion/cli": "4.0.539",
    "@remotion/renderer": "4.0.539",
    "@remotion/three": "4.0.539",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "remotion": "4.0.539",
    "three": "0.170.0"
  },
  "devDependencies": {
    "@types/node": "22.10.5",
    "@types/react": "18.3.18",
    "@types/react-dom": "18.3.5",
    "@types/three": "0.170.0",
    "tsx": "4.23.15",
    "typescript": "5.7.3"
  },
  "overrides": {
    "zod": "4.6.6"
  }
}
